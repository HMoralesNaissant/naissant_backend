			<property name="com.jaspersoft.studio.field.tree.path" value="inv_productos"/>
		</field>
		<field name="Nombre" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
			<property name="com.jaspersoft.studio.field.label" value="Nombre"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="inv_evidencias"/>
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="Calidad" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
			<property name="com.jaspersoft.studio.field.label" value="Calidad"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="inv_clasificacion_productos"/>
