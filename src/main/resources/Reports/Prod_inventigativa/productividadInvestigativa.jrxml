	<subDataset name="reporteProductividadTipoProd" uuid="512e6ce7-9b8b-4361-b52f-0a149c9c5f59">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Reporte Gestion Investigativa"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="idInvestigador" class="java.lang.String"/>
		<parameter name="fechaIni" class="java.lang.String"/>
		<parameter name="fechaFin" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT 
	CONCAT(cp.nombre, ' ', cp.apellidos) AS "Investigador",
    itp.nombre AS "Categoría",
    ip.nombre AS "Tipo",
    COUNT(icp.id_producto) AS "Cantidad",
    SUM(icp.puntaje) AS "Total Puntos"
    
FROM 
	inv_calificacion_productos AS icp
    INNER JOIN inv_evidencias AS ie ON icp.id_evidencia = ie.id
    INNER JOIN inv_investigadores AS ii ON ie.id_investigador = ii.id
    INNER JOIN conf_personas AS cp ON ii.id_persona = cp.id
	INNER JOIN inv_tipo_productos AS itp ON icp.id_tipo_producto = itp.id
	INNER JOIN inv_productos AS ip ON icp.id_producto = ip.id
WHERE
	icp.status = 'A' AND 
    ie.id_investigador =   $P{idInvestigador} AND
		icp.date_create BETWEEN  $P{fechaIni} AND $P{fechaFin} 
GROUP BY
	-- icp.id_producto;
	icp.participantes]]>
		</queryString>
		<field name="Investigador" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Investigador"/>
			<property name="com.jaspersoft.studio.field.label" value="Investigador"/>
		</field>
		<field name="Categoría" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
			<property name="com.jaspersoft.studio.field.label" value="Categoría"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="inv_tipo_productos"/>
		</field>
		<field name="Tipo" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
			<property name="com.jaspersoft.studio.field.label" value="Tipo"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="inv_productos"/>
		</field>
		<field name="Cantidad" class="java.lang.Long">
			<property name="com.jaspersoft.studio.field.name" value="Cantidad"/>
			<property name="com.jaspersoft.studio.field.label" value="Cantidad"/>
		</field>
		<field name="Total Puntos" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="Total Puntos"/>
			<property name="com.jaspersoft.studio.field.label" value="Total Puntos"/>
		</field>
		<variable name="Total Puntos1" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{Total Puntos}]]></variableExpression>
		</variable>
		<variable name="Cantidad1" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{Cantidad}]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="ProductividaCategorias" uuid="195cfd18-4ad9-4cdf-9857-c2ed68413d3c">
