	<subDataset name="ResumenProductividadTipoProd" uuid="559209a5-e6db-483a-a624-53fb773b6763">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Reportes"/>
		<parameter name="idInvestigador" class="java.lang.String"/>
		<parameter name="fechaIni" class="java.lang.String"/>
		<parameter name="fechaFin" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[SELECT
			itp.nombre AS "Categoría",
		    ip.nombre AS "Tipo",
		    ie.nombre AS "Nombre",
		    iclp.nombre AS "Calidad",
		    icp.evaluacion AS "Evaluación",
		    icp.calificacion AS "Calificación",
		    icp.porcentaje AS "Porcentaje",
		    icp.puntaje AS "Puntaje"
FROM
			inv_calificacion_productos AS icp
		    INNER JOIN inv_evidencias AS ie ON icp.id_evidencia = ie.id
		    INNER JOIN inv_investigadores AS ii ON ie.id_investigador = ii.id
		    INNER JOIN inv_tipo_productos AS itp ON icp.id_tipo_producto = itp.id
		    INNER JOIN inv_productos AS ip ON icp.id_producto = ip.id
		    INNER JOIN inv_clasificacion_productos AS iclp ON ip.id = iclp.id
WHERE
			icp.status = 'A' AND 
		    ie.id_investigador =  $P{idInvestigador} AND
			icp.date_create BETWEEN  $P{fechaIni} AND  $P{fechaFin}]]>
		</queryString>
		<field name="Categoría" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="nombre"/>
