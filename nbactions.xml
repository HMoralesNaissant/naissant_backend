<?xml version="1.0" encoding="UTF-8"?>
<actions>
        <action>
            <actionName>CUSTOM-package</actionName>
            <displayName>package</displayName>
            <goals>
                <goal>package</goal>
            </goals>
            <activatedProfiles>
                <activatedProfile>DEV</activatedProfile>
            </activatedProfiles>
        </action>
        <action>
            <actionName>CUSTOM-run</actionName>
            <displayName>run</displayName>
            <goals>
                <goal>spring-boot:run</goal>
            </goals>
            <properties>
                <Env.spring.profiles.active>dev</Env.spring.profiles.active>
            </properties>
        </action>
        <action>
            <actionName>run</actionName>
            <packagings>
                <packaging>jar</packaging>
            </packagings>
            <goals>
                <goal>process-classes</goal>
                <goal>org.codehaus.mojo:exec-maven-plugin:1.2.1:exec</goal>
            </goals>
            <properties>
                <exec.args>-classpath %classpath com.naissant.naissantapp.DashboardAppApplication</exec.args>
                <exec.executable>java</exec.executable>
            </properties>
        </action>
    </actions>
